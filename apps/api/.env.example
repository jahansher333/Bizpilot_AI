# Copy to .env for local development. Every value below is fake and unusable.
BIZPILOT_ENVIRONMENT=local
BIZPILOT_DEBUG=true
# JSON list of browser origins allowed to call the API. Production requires https origins; "*" is rejected.
BIZPILOT_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
BIZPILOT_DATABASE__URL=postgresql://fake_user:fake_password@localhost:5432/bizpilot_local
BIZPILOT_AUTH__SIGNING_SECRET=local-only-fake-signing-secret-not-for-real-use
BIZPILOT_AUTH__ACCESS_TOKEN_MINUTES=15
# Login: failed attempts per email+IP; forgot-password: requests per email; reset-password: requests per IP.
BIZPILOT_AUTH__RATE_LIMIT_WINDOW_MINUTES=15
BIZPILOT_AUTH__LOGIN_MAX_FAILURES=5
BIZPILOT_AUTH__RECOVERY_MAX_REQUESTS=5
BIZPILOT_AI__ENABLED=false
BIZPILOT_AI__API_KEY=
BIZPILOT_AI__MODEL=
BIZPILOT_LOGGING__LEVEL=DEBUG
BIZPILOT_LOGGING__JSON_LOGS=false
